# The iOS app to TestFlight, from CI (.github/workflows/release-ios.yml). The Xcode project
# (apps/ios) is prepared first by `tools/ios.sh prepare`: the engine with the unmath lessons.
#
# Signing needs no certificate repository: Xcode signs automatically with an App Store Connect
# API key (cloud-managed distribution certificate, profiles created on demand), so the
# sealsbroken repositories and the key are all a release needs.
#
# Environment:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT  an App Store Connect API key with the Admin role
#                                               (cloud-managed certificates need it);
#                                               ASC_KEY_CONTENT is the .p8 file's text
#   MARKETING_VERSION, CURRENT_PROJECT_VERSION  from scripts/resolve-release-version.sh

default_platform(:ios)

PROJECT = File.expand_path("../apps/ios/UnApp.xcodeproj", __dir__)
TEAM_ID = "7C7LXXWRMG"

platform :ios do
  desc "Archive, sign (automatic, with the API key) and upload to TestFlight"
  lane :testflight_release do
    setup_ci(force: true)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      in_house: false
    )

    # xcodebuild reads the key from a file for -allowProvisioningUpdates.
    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
    File.write(key_path, ENV.fetch("ASC_KEY_CONTENT"))
    File.chmod(0o600, key_path)
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    ].join(" ")

    begin
      gym(
        project: PROJECT,
        scheme: "UnApp",
        configuration: "Release",
        destination: "generic/platform=iOS",
        export_method: "app-store",
        archive_path: "build/ios/Un.xcarchive",
        export_options: { signingStyle: "automatic", teamID: TEAM_ID },
        xcargs: [
          auth,
          "MARKETING_VERSION=#{ENV.fetch('MARKETING_VERSION')}",
          "CURRENT_PROJECT_VERSION=#{ENV.fetch('CURRENT_PROJECT_VERSION')}",
          "DEVELOPMENT_TEAM=#{TEAM_ID}",
          "CODE_SIGN_STYLE=Automatic",
          "COMPILER_INDEX_STORE_ENABLE=NO"
        ].join(" "),
        # gym passes `xcargs` to the export too: the key reaches -exportArchive without a second copy.
        output_directory: "build/ios",
        output_name: "Un.ipa"
      )
    ensure
      File.delete(key_path) if File.exist?(key_path)
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/Un.ipa",
      # Processing takes a while: the `external` lane waits for it on a cheaper runner.
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload the App Store listing text to App Store Connect (no binary)"
  desc "From fastlane/metadata/ios (en-US, ru); CI: .github/workflows/app-store-metadata.yml."
  desc "Options: platform:ios (default) or platform:osx, the Mac app's listing (the same record);"
  desc "screenshots:true also replaces the screenshots with fastlane/screenshots/<ios|mac>"
  desc "(tools/screenshots.sh makes them)."
  desc "Environment: the ASC_* key; ASC_APP_VERSION, optional: the version whose texts to edit"
  desc "(default: the editable one, the version being prepared)."
  lane :upload_metadata do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV["ASC_KEY_PATH"],
      key_content: ENV["ASC_KEY_CONTENT"],
      in_house: false
    )
    version = ENV["ASC_APP_VERSION"].to_s.strip
    platform = options[:platform] || "ios"
    # From the command line a string: screenshots:true.
    screenshots = options[:screenshots].to_s == "true"
    deliver(
      api_key: api_key,
      app_identifier: "app.onym.undigit",
      platform: platform,
      app_version: version.empty? ? nil : version,
      metadata_path: "./fastlane/metadata/ios",
      # No binary and nothing submitted for review; screenshots only when asked, replacing all.
      skip_binary_upload: true,
      skip_screenshots: !screenshots,
      screenshots_path: "./fastlane/screenshots/#{platform == 'osx' ? 'mac' : 'ios'}",
      overwrite_screenshots: screenshots,
      skip_metadata: false,
      # Non-interactive: no HTML preview, no prompt.
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Upload the app previews (videos) in fastlane/previews/<ios|mac>/<locale> to App Store Connect"
  desc "Made by tools/app-preview.sh; the type is in the file name (iphone-IPHONE_67.mp4) and the"
  desc "poster frame in <name>.poster. Each type's previews in that locale are replaced. deliver"
  desc "cannot upload previews, hence the App Store Connect API directly."
  desc "Options: platform:ios (default) or platform:osx. Environment: the ASC_* key."
  lane :upload_previews do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV["ASC_KEY_PATH"],
      key_content: ENV["ASC_KEY_CONTENT"],
      in_house: false
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    mac = options[:platform].to_s == "osx"
    root = File.expand_path("../fastlane/previews/#{mac ? 'mac' : 'ios'}", __dir__)
    files = Dir.glob(File.join(root, "*", "*.{mp4,mov}")).sort
    if files.empty?
      UI.important("no previews in #{root}")
      next
    end

    app = Spaceship::ConnectAPI::App.find("app.onym.undigit") or UI.user_error!("no app app.onym.undigit in App Store Connect")
    platform = mac ? Spaceship::ConnectAPI::Platform::MAC_OS : Spaceship::ConnectAPI::Platform::IOS
    version = app.get_edit_app_store_version(platform: platform) or UI.user_error!("no editable #{platform} version")
    localizations = version.get_app_store_version_localizations

    files.group_by { |f| File.basename(File.dirname(f)) }.each do |locale, paths|
      localization = localizations.find { |l| l.locale == locale } or UI.user_error!("no #{locale} localization on #{version.version_string}")
      sets = localization.get_app_preview_sets
      paths.each do |path|
        type = Spaceship::ConnectAPI::AppPreviewSet.preview_type_from_filename(File.basename(path)) or
          UI.user_error!("#{path}: name the file after its type, e.g. iphone-IPHONE_67.mp4")
        set = sets.find { |s| s.preview_type == type } ||
              localization.create_app_preview_set(attributes: { previewType: type })
        (set.app_previews || []).each(&:delete!)
        poster = File.exist?(path.sub(/\.\w+$/, ".poster")) ? File.read(path.sub(/\.\w+$/, ".poster")).strip : nil
        UI.message("#{locale} #{type}: uploading #{File.basename(path)}#{poster ? " (poster #{poster})" : ''}")
        set.upload_preview(path: path, wait_for_processing: false, frame_time_code: poster)
      end
    end
    UI.success("previews uploaded; App Store Connect processes them for a few minutes")
  end

  desc "Once Apple has processed a build, give it to the External group (submits Beta App Review)"
  desc "Environment: the ASC_* key, TF_VERSION, TF_BUILD, TF_WHAT_TO_TEST (the testers' notes),"
  desc "TF_PLATFORM (ios, the default, or osx for the Mac app)"
  lane :external do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      in_house: false
    )
    version = ENV.fetch("TF_VERSION")
    build_number = ENV.fetch("TF_BUILD")
    platform = ENV["TF_PLATFORM"].to_s.empty? ? "ios" : ENV["TF_PLATFORM"]
    api_platform = platform == "osx" ? "MAC_OS" : "IOS"

    # External distribution needs a processed build: poll until App Store Connect has one
    # (an upload shows up after a few minutes, processing takes up to half an hour or so).
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find("app.onym.undigit") or UI.user_error!("no app app.onym.undigit in App Store Connect")
    deadline = Time.now + 90 * 60
    loop do
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build_number, platform: api_platform).first
      state = build&.processing_state
      UI.message("#{platform} build #{version} (#{build_number}): #{state || 'not in App Store Connect yet'}")
      break if state == "VALID"
      UI.user_error!("build #{version} (#{build_number}) failed processing: #{state}") if %w[FAILED INVALID].include?(state)
      UI.user_error!("build #{version} (#{build_number}) still not processed after 90 minutes") if Time.now > deadline
      sleep 60
    end

    upload_to_testflight(
      api_key: api_key,
      distribute_only: true,
      app_identifier: "app.onym.undigit",
      # Without an .ipa to read it from, pilot would ask (and fail in CI).
      app_platform: platform,
      app_version: version,
      build_number: build_number,
      distribute_external: true,
      groups: ["External"],
      changelog: ENV.fetch("TF_WHAT_TO_TEST"),
      notify_external_testers: true,
      submit_beta_review: true
    )
  end
end

# The Mac app (the UnMac target: the iOS screens as a native, sandboxed Mac app) to TestFlight,
# from CI (.github/workflows/release-macos-testflight.yml), after `tools/ios.sh mac-prepare`. The
# same bundle ID as the iOS app: one App Store Connect record with a macOS platform. Signed and
# uploaded by xcodebuild itself with the API key (cloud-managed Apple Distribution and Mac
# Installer Distribution certificates), no certificate in the repository's secrets.
#
# Environment: as the iOS lane (the ASC_* key, MARKETING_VERSION, CURRENT_PROJECT_VERSION).
platform :mac do
  desc "Archive the Mac app, sign it and upload it to TestFlight"
  lane :testflight_release do
    setup_ci(force: true)

    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
    File.write(key_path, ENV.fetch("ASC_KEY_CONTENT"))
    File.chmod(0o600, key_path)
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
    ]
    archive = File.expand_path("../build/mac/Un.xcarchive", __dir__)
    options = File.expand_path("../build/mac/ExportOptions.plist", __dir__)
    FileUtils.mkdir_p(File.dirname(options))
    # destination upload: xcodebuild signs for the Mac App Store, packages and uploads in one go.
    File.write(options, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store-connect</string>
        <key>destination</key><string>upload</string>
        <key>signingStyle</key><string>automatic</string>
        <key>teamID</key><string>#{TEAM_ID}</string>
        <key>manageAppVersionAndBuildNumber</key><false/>
      </dict>
      </plist>
    PLIST

    begin
      # Hosted runners have no reusable development key. Ad-hoc sign the temporary
      # archive (as Xcode Cloud does), retaining its sandbox entitlements; export
      # below applies the real App Store signature with cloud-managed certificates.
      sh("xcodebuild", "-project", PROJECT, "-scheme", "UnMac", "-configuration", "Release",
         "-destination", "generic/platform=macOS", "-archivePath", archive, *auth,
         "MARKETING_VERSION=#{ENV.fetch('MARKETING_VERSION')}",
         "CURRENT_PROJECT_VERSION=#{ENV.fetch('CURRENT_PROJECT_VERSION')}",
         "DEVELOPMENT_TEAM=#{TEAM_ID}", "CODE_SIGN_STYLE=Automatic", "CODE_SIGN_IDENTITY=-",
         "AD_HOC_CODE_SIGNING_ALLOWED=YES", "COMPILER_INDEX_STORE_ENABLE=NO",
         "archive", "-quiet")
      sh("xcodebuild", "-exportArchive", "-archivePath", archive, "-exportOptionsPlist", options,
         "-exportPath", File.dirname(archive), *auth)
    ensure
      File.delete(key_path) if File.exist?(key_path)
    end
  end
end

# The Google Play listing (supply), from CI (.github/workflows/play-store-metadata.yml): the
# texts, icon, feature graphic and phone screenshots in fastlane/metadata/android/<locale>, no
# binary (Release Android uploads those). Play takes listing changes only once a build exists, so
# the first bundle and the console's required forms (content rating, data safety, target audience,
# pricing) come first, by hand.
#
# Environment: SUPPLY_JSON_KEY_DATA, the service account's JSON key (PLAY_SERVICE_ACCOUNT_JSON).
platform :android do
  desc "Upload the Play listing (texts, images and screenshots) from fastlane/metadata/android"
  lane :play_metadata do |options|
    # images:false (from the command line, a string) leaves the graphics as they are.
    skip_images = options[:images].to_s == "false"
    upload_to_play_store(
      package_name: "app.onym.un",
      # supply ties a listing edit to a track with a release: internal has one from the first
      # bundle on (production may not yet).
      track: options[:track] || "internal",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: skip_images,
      skip_upload_screenshots: skip_images,
      # Play's image endpoint can fail when several locales' graphics upload at once.
      sync_image_upload: true
    )
  end
end
